# Social Media Content Analyzer Configuration Template
server.port=8080
spring.servlet.multipart.max-file-size=25MB
spring.servlet.multipart.max-request-size=25MB

# AI API Configuration (Google Gemini 3.7 Flash API)
# Set your API key in environment variable AI_API_KEY or replace below:
# Windows PowerShell: $env:AI_API_KEY="your_api_key_here"
# Linux/macOS: export AI_API_KEY="your_api_key_here"
ai.api.key=${AI_API_KEY:your_gemini_api_key_here}
ai.api.url=${AI_API_URL:https://generativelanguage.googleapis.com/v1beta/models/gemini-3.7-flash:generateContent}
